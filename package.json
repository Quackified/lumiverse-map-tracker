{
  "name": "map-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:backend": "bun build src/backend.ts --outfile dist/backend.js --target bun --minify",
    "build:frontend": "bun build src/frontend.ts --outfile dist/frontend.js --target browser --minify",
    "build": "bun run build:backend && bun run build:frontend",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lumiverse-spindle-types": "^0.6.77",
    "typescript": "^5.9.3"
  }
}
